{
    "name": "atomjoy/cookie-buzz",
    "description": "CookieBuzz Cookie Consent Banner for Google Analytics and FacebookPixel in Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Atomjoy",
            "email": "atomjoy.official@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {},
    "autoload": {
        "classmap": [
            "src/"
        ],
        "psr-4": {
            "CookieBuzz\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Migrations\\": "database/migrations/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "CookieBuzz\\Tests\\": "tests/"
        },
        "files": []
    },
    "extra": {
        "laravel": {
            "providers": [
                "CookieBuzz\\CookieBuzzServiceProvider"
            ],
            "aliases": {
                "CookieBuzz": "CookieBuzz\\Facades\\CookieBuzz"
            }
        }
    }
}